{
  "name": "rplus-splamei-client-pc",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win dir",
    "build:linux": "electron-builder --linux dir"
  },
  "keywords": [],
  "author": "Splamei",
  "license": "Apache-2.0",
  "description": "A client to play the Rhythm Plus music game in an app right on your device",
  "build": {
    "appId": "com.splamei.rplus-client.pc",
    "productName": "Rhythm Plus - Splamei Client",
    "asar": true,
    "files": [
      "LICENCE",
      "logo.png",
      "main.js",
      "NOTICE",
      "preload.json",
      "settings.html",
      "settings.js",
      "splashLoad.html",
      "assets/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "electronLanguages": [
        "en-US"
      ]
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-log": "^5.4.4",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
